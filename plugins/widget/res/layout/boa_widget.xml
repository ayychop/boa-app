<?xml version="1.0" encoding="utf-8"?>
<!-- BOA home screen widget: a pane of frosted glass (tinted and made as
     clear as you like in the app). Laid out like a weather widget: the clock
     and date on the left, today's weather on the right, and under a
     hairline what's playing, with the station's record (or the BOA logo
     when nothing plays). TextClock keeps time on its own, so the widget
     never needs to wake the app. The weather opens the forecast; the rest
     opens what's playing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/boa_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/boa_widget_glass"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_glass" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_sheen" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_edge" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Time and date | weather -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/boa_widget_clock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
          android:id="@+id/boa_widget_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-light"
          android:format12Hour="h:mm"
          android:format24Hour="HH:mm"
          android:includeFontPadding="false"
          android:letterSpacing="-0.02"
          android:maxLines="1"
          android:textColor="#F3EFE8"
          android:textSize="44sp" />

        <TextClock
          android:id="@+id/boa_widget_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:fontFamily="sans-serif-medium"
          android:format12Hour="EEE, d MMMM"
          android:format24Hour="EEE, d MMMM"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="#B3F3EFE8"
          android:textSize="13sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/boa_widget_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/boa_widget_weather"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <ImageView
            android:id="@+id/boa_widget_wx_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/boa_wx_partly" />

          <TextView
            android:id="@+id/boa_widget_wx_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/boa_widget_wx_blank"
            android:textColor="#F3EFE8"
            android:textSize="32sp" />
        </LinearLayout>

        <TextView
          android:id="@+id/boa_widget_wx_place"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:drawablePadding="3dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxWidth="150dp"
          android:maxLines="1"
          android:text="@string/boa_widget_wx_setup"
          android:textColor="#F3EFE8"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/boa_widget_wx_detail"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxWidth="150dp"
          android:maxLines="1"
          android:textColor="#B3F3EFE8"
          android:textSize="11sp"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>

    <View
      android:id="@+id/boa_widget_rule"
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:background="#1FF3EFE8" />

    <!-- What's playing -->
    <LinearLayout
      android:id="@+id/boa_widget_media"
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
          android:id="@+id/boa_widget_art"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@string/boa_widget_record"
          android:scaleType="fitCenter"
          android:visibility="gone" />

        <ImageView
          android:id="@+id/boa_widget_logo"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@string/boa_widget_logo"
          android:scaleType="fitCenter"
          android:src="@drawable/boa_widget_wordmark" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/boa_widget_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="monospace"
          android:includeFontPadding="false"
          android:letterSpacing="0.12"
          android:maxLines="1"
          android:text="@string/boa_widget_cta"
          android:textColor="#E2A84B"
          android:textSize="10sp" />

        <TextView
          android:id="@+id/boa_widget_subtitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="#B3F3EFE8"
          android:textSize="12.5sp"
          android:visibility="gone" />
      </LinearLayout>

      <ImageView
        android:id="@+id/boa_widget_live"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/boa_widget_live"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
