<?xml version="1.0" encoding="utf-8"?>
<!-- BOA widget, Record: the minimal radio wheel. A square of glass with
     the station's record large in the middle (the BOA logo when nothing
     plays), its name and the song under it. Tapping opens what's playing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/boa_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/boa_widget_glass"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_glass" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_sheen" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/boa_widget_edge" />

  <LinearLayout
    android:id="@+id/boa_widget_media"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minWidth="64dp"
      android:minHeight="64dp">

      <ImageView
        android:id="@+id/boa_widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/boa_widget_record"
        android:scaleType="fitCenter"
        android:visibility="gone" />

      <ImageView
        android:id="@+id/boa_widget_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/boa_widget_logo"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/boa_widget_wordmark" />
    </FrameLayout>

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/boa_widget_live"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/boa_widget_live"
        android:visibility="gone" />

      <TextView
        android:id="@+id/boa_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="@string/boa_widget_cta_short"
        android:textColor="#E2A84B"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/boa_widget_subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="2"
      android:textColor="#B3F3EFE8"
      android:textSize="14sp"
      android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
