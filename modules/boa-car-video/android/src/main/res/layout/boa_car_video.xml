<?xml version="1.0" encoding="utf-8"?>
<!-- The parked-only player: the picture, and over it the static "parked
     only" card that replaces the picture the moment the car moves. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#050506">

  <androidx.media3.ui.PlayerView
    android:id="@+id/boa_car_player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:show_buffering="when_playing"
    app:use_controller="true" />

  <LinearLayout
    android:id="@+id/boa_car_hold"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050506"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp"
    android:visibility="gone">

    <TextView
      android:id="@+id/boa_car_hold_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center"
      android:textColor="#F3EFE8"
      android:textSize="32sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/boa_car_hold_body"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:gravity="center"
      android:text="Video plays only when the car is parked. It has paused."
      android:textColor="#B3F3EFE8"
      android:textSize="24sp" />

    <Button
      android:id="@+id/boa_car_resume"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:minHeight="76dp"
      android:paddingStart="40dp"
      android:paddingEnd="40dp"
      android:text="Resume"
      android:textSize="24sp"
      android:visibility="gone" />

    <Button
      android:id="@+id/boa_car_close"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:minHeight="76dp"
      android:paddingStart="40dp"
      android:paddingEnd="40dp"
      android:text="Close"
      android:textSize="24sp" />
  </LinearLayout>
</FrameLayout>
