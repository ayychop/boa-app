{
  "expo": {
    "name": "BOA HUB",
    "slug": "boa-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "BOA uses your approximate location to show local weather.",
        "NSCameraUsageDescription": "BOA uses the camera for BOA video calls.",
        "NSMicrophoneUsageDescription": "BOA uses the microphone for voice notes and BOA video calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050506",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.boanetsteam.boaapp",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#050506",
      "bundler": "metro",
      "output": "single",
      "name": "BOA HUB",
      "shortName": "BOA HUB",
      "description": "BOA HUB by BOA Network: radio, BOA Originals and the Creative Hub, where creatives get discovered and get paid.",
      "themeColor": "#050506",
      "lang": "en"
    },
    "backgroundColor": "#050506",
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#050506",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#050506"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "enableProguardInReleaseBuilds": false,
            "enableR8InReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "BOA uses the microphone to record voice notes in Creative Hub chats.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-status-bar",
      [
        "./plugins/withAndroidConfigChanges",
        {
          "configChanges": [
            "keyboard",
            "keyboardHidden",
            "orientation",
            "screenSize",
            "screenLayout",
            "smallestScreenSize",
            "uiMode",
            "density"
          ]
        }
      ],
      "./plugins/withBoaWidget",
      "expo-video",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BOA uses your approximate location to show local weather.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your Creative Hub avatar and chats.",
          "cameraPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm_bowl.wav",
            "./assets/sounds/alarm_chimes.wav",
            "./assets/sounds/alarm_classic.wav",
            "./assets/sounds/chat_pager.wav",
            "./assets/sounds/chat_messenger.wav",
            "./assets/sounds/chat_airhorn.wav",
            "./assets/sounds/chat_scratch.wav",
            "./assets/sounds/chat_cashregister.wav",
            "./assets/sounds/chat_bassdrop.wav"
          ],
          "icon": "./assets/notification-icon.png",
          "color": "#E2A84B"
        }
      ]
    ],
    "owner": "boanets-team",
    "extra": {
      "eas": {
        "projectId": "f08c9a51-4138-4a1f-a97e-74994582a693"
      }
    },
    "scheme": "network.boa"
  }
}
