# BOA HUB (Creative Hub) Supabase project. Copy this file to .env.local
# (which git ignores) and fill in the values from the Supabase dashboard:
# Project Settings > API. Use the anon (public) key, never service_role.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
